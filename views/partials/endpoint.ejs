<div class="endpoint-card" data-endpoint-id="<%= ep.id %>">
  <div class="endpoint-header">
    <div class="endpoint-method-badge">
      <span class="method-badge method-<%= ep.method.toLowerCase() %>"><%= ep.method %></span>
      <code class="endpoint-path"><%= ep.path %></code>
    </div>
    <div class="endpoint-meta">
      <h3 class="endpoint-name"><%= ep.name %></h3>
      <% if (ep.auth) { %>
        <span class="auth-tag auth-<%= ep.auth %>">
          <%= ep.auth === 'admin' ? '🔑 Admin Only' : (ep.auth === 'user' ? '🔐 Authenticated' : '🌐 Public') %>
        </span>
      <% } %>
    </div>
  </div>
  
  <p class="endpoint-description"><%= ep.description %></p>
  
  <div class="endpoint-content-split">
    <!-- LEFT: Interactive Form -->
    <div class="endpoint-form-section">
      <div class="section-header">
        <svg class="section-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 4h16v16H4z"/><path d="M8 8h8v2H8zM8 12h6v2H8zM8 16h4v2H8z"/>
        </svg>
        <span>Test Endpoint</span>
      </div>
      
      <form class="api-tester" data-method="<%= ep.method %>" data-path="<%= ep.path %>" data-auth="<%= ep.auth %>">
        <!-- Parameters (Path Params) -->
        <% if (ep.params && ep.params.length) { %>
          <div class="form-group">
            <label>Path Parameters</label>
            <% ep.params.forEach(function(param) { %>
              <div class="param-field">
                <input type="text" name="param_<%= param.name %>" placeholder="<%= param.name %>" class="form-input" data-param-in="<%= param.in %>">
                <span class="param-type"><%= param.in %></span>
                <small><%= param.desc %></small>
              </div>
            <% }) %>
          </div>
        <% } %>
        
        <!-- Query Parameters -->
        <% if (ep.queryParams && ep.queryParams.length) { %>
          <div class="form-group">
            <label>Query Parameters</label>
            <% ep.queryParams.forEach(function(param) { %>
              <div class="param-field">
                <input type="text" name="<%= param.name %>" placeholder="<%= param.name %>" class="form-input">
                <span class="param-type">query</span>
                <small><%= param.desc %></small>
              </div>
            <% }) %>
          </div>
        <% } %>
        
        <!-- AUTHENTICATION ENDPOINTS - Special Forms -->
        
        <!-- REGISTER Form -->
        <% if (ep.path === '/api/auth/register' && ep.method === 'POST') { %>
          <div class="form-group">
            <label>Email <span class="required">*</span></label>
            <input type="email" name="email" class="form-input" placeholder="user@example.com" required>
          </div>
          <div class="form-group">
            <label>Password <span class="required">*</span></label>
            <input type="password" name="password" class="form-input" placeholder="Min 8 characters" required>
          </div>
          <div class="form-group">
            <label>Full Name <span class="required">*</span></label>
            <input type="text" name="full_name" class="form-input" placeholder="John Doe" required>
          </div>
        <% } %>
        
        <!-- LOGIN Form -->
        <% if (ep.path === '/api/auth/login' && ep.method === 'POST') { %>
          <div class="form-group">
            <label>Email <span class="required">*</span></label>
            <input type="email" name="email" class="form-input" placeholder="user@example.com" required>
          </div>
          <div class="form-group">
            <label>Password <span class="required">*</span></label>
            <input type="password" name="password" class="form-input" placeholder="Password" required>
          </div>
        <% } %>
        
        <!-- UPDATE PROFILE Form -->
        <% if (ep.path === '/api/auth/me' && ep.method === 'PUT') { %>
          <div class="form-group">
            <label>Full Name</label>
            <input type="text" name="full_name" class="form-input" placeholder="New full name">
          </div>
        <% } %>
        
        <!-- CHANGE PASSWORD Form -->
        <% if (ep.path === '/api/auth/change-password' && ep.method === 'POST') { %>
          <div class="form-group">
            <label>Current Password <span class="required">*</span></label>
            <input type="password" name="current_password" class="form-input" placeholder="Current password" required>
          </div>
          <div class="form-group">
            <label>New Password <span class="required">*</span></label>
            <input type="password" name="new_password" class="form-input" placeholder="New password (min 8 chars)" required>
          </div>
        <% } %>
        
        <!-- FORGOT PASSWORD Form -->
        <% if (ep.path === '/api/auth/forgot-password' && ep.method === 'POST') { %>
          <div class="form-group">
            <label>Email <span class="required">*</span></label>
            <input type="email" name="email" class="form-input" placeholder="user@example.com" required>
          </div>
        <% } %>
        
        <!-- RESET PASSWORD Form -->
        <% if (ep.path === '/api/auth/reset-password' && ep.method === 'POST') { %>
          <div class="form-group">
            <label>Reset Token <span class="required">*</span></label>
            <input type="text" name="token" class="form-input" placeholder="Reset token from email" required>
          </div>
          <div class="form-group">
            <label>New Password <span class="required">*</span></label>
            <input type="password" name="new_password" class="form-input" placeholder="New password" required>
          </div>
        <% } %>
        
        <!-- REFRESH TOKEN Form -->
        <% if (ep.path === '/api/auth/refresh' && ep.method === 'POST') { %>
          <div class="form-group">
            <label>Refresh Token <span class="required">*</span></label>
            <input type="text" name="refresh_token" class="form-input" placeholder="Your refresh token" required>
          </div>
        <% } %>
        
        <!-- ADMIN: GET ALL USERS Form -->
        <% if (ep.path === '/api/admin/users' && ep.method === 'GET') { %>
          <div class="form-group">
            <label>Page (optional)</label>
            <input type="number" name="page" class="form-input" placeholder="1" value="1">
          </div>
          <div class="form-group">
            <label>Limit (optional)</label>
            <input type="number" name="limit" class="form-input" placeholder="20" value="20">
          </div>
        <% } %>
        
        <!-- ADMIN: ACTIVATE USER Form -->
        <% if (ep.path === '/api/admin/users/:id/activate' && ep.method === 'PUT') { %>
          <div class="form-group">
            <label>User ID <span class="required">*</span></label>
            <input type="text" name="param_id" class="form-input" placeholder="User ID" required>
          </div>
          <div class="form-group">
            <label>Active Status</label>
            <select name="is_active" class="form-input">
              <option value="true">Activate</option>
              <option value="false">Deactivate</option>
            </select>
          </div>
        <% } %>
        
        <!-- ADMIN: DELETE USER Form -->
        <% if (ep.path === '/api/admin/users/:id' && ep.method === 'DELETE') { %>
          <div class="form-group">
            <label>User ID <span class="required">*</span></label>
            <input type="text" name="param_id" class="form-input" placeholder="User ID" required>
          </div>
        <% } %>
        
        <!-- ADMIN: GET USER BY ID Form -->
        <% if (ep.path === '/api/admin/users/:id' && ep.method === 'GET') { %>
          <div class="form-group">
            <label>User ID <span class="required">*</span></label>
            <input type="text" name="param_id" class="form-input" placeholder="User ID" required>
          </div>
        <% } %>
        
        <!-- Features and Significants TEXT FIELDS -->
        <% if ((ep.path.includes('/features') || ep.path.includes('/significants')) && (ep.method === 'POST' || ep.method === 'PUT')) { %>
          
          <!-- Title Field - REQUIRED -->
          <div class="form-group">
            <label>Title <span class="required">*</span></label>
            <input type="text" name="title" class="form-input" placeholder="Enter title" required>
          </div>
          
          <!-- Description Field - REQUIRED -->
          <div class="form-group">
            <label>Description <span class="required">*</span></label>
            <textarea name="description" class="form-textarea" rows="4" placeholder="Enter description" required></textarea>
          </div>
          
          <!-- Features Specific Fields -->
          <% if (ep.path.includes('/features')) { %>
            <div class="form-group">
              <label>Category</label>
              <input type="text" name="category" class="form-input" placeholder="e.g., integration, security, analytics">
            </div>
            
            <div class="form-group">
              <label>Display Order</label>
              <input type="number" name="order" class="form-input" placeholder="0" value="0">
            </div>
          <% } %>
          
          <!-- Significants Specific Fields -->
          <% if (ep.path.includes('/significants')) { %>
            <div class="form-group">
              <label>Highlight Text</label>
              <input type="text" name="highlight_text" class="form-input" placeholder="e.g., WINNER, FEATURED, NEW">
            </div>
            
            <div class="form-group">
              <label>Priority (1-10)</label>
              <input type="number" name="priority" class="form-input" placeholder="5" min="1" max="10" value="5">
            </div>
            
            <div class="form-group">
              <label>Icon URL (Optional)</label>
              <input type="text" name="icon_url" class="form-input" placeholder="https://example.com/icon.svg">
            </div>
          <% } %>
          
          <!-- Image Upload Dropzone -->
          <div class="form-group">
            <label>Main Image</label>
            <div class="dropzone" data-input="image_input_<%= ep.id %>" data-preview="preview_<%= ep.id %>">
              <svg class="upload-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 4v16M4 12h16"/>
              </svg>
              <p>Drag & drop an image here or click to browse</p>
              <small>Supports JPG, PNG, GIF, WebP, SVG (Max 5MB)</small>
              <input type="file" id="image_input_<%= ep.id %>" class="file-input" accept="image/*" style="display:none">
              <div class="image-preview" id="preview_<%= ep.id %>"></div>
            </div>
            <input type="hidden" name="image_url" class="image-url-field">
          </div>
          
          <!-- Thumbnail URL Field -->
          <div class="form-group">
            <label>Thumbnail URL (Optional)</label>
            <input type="text" name="thumbnail_url" class="form-input" placeholder="https://example.com/thumb.jpg">
          </div>
          
        <% } else if (ep.body && !ep.path.includes('/auth')) { %>
          <!-- JSON Editor for other endpoints -->
          <div class="form-group">
            <label>Request Body (JSON)</label>
            <textarea name="body" class="form-textarea json-editor" rows="8"><%= typeof ep.body === 'object' ? JSON.stringify(ep.body, null, 2) : ep.body %></textarea>
            <button type="button" class="btn-format-json" data-action="format-json">✨ Format JSON</button>
          </div>
        <% } %>
        
        <!-- Authentication Section -->
        <div class="form-group auth-group">
          <label>Authentication</label>
          
          <!-- Bearer Token for User endpoints -->
          <% if (ep.auth === 'user') { %>
            <input type="text" name="auth_token" class="form-input" placeholder="Bearer Token (JWT)">
            <small>Enter your JWT access token from login</small>
          <% } %>
          
          <!-- Admin API Key for Admin endpoints -->
          <% if (ep.auth === 'admin') { %>
            <div class="admin-key-container">
              <div class="admin-key-header">
                <i class="fas fa-key"></i>
                <span>Admin API Key</span>
              </div>
              <div class="admin-key-display">
                <code class="admin-key-code">•••••••••••••••••••••••••••••••••••</code>
                <button type="button" class="btn-copy-key" data-action="copy-admin-key">📋 Copy</button>
              </div>
              <input type="hidden" name="admin_key" class="admin-key-input" value="a7f3e8d9c2b1h4k6m9n2p5q8r3t6w1x4y7z0">
              <small>This key is automatically added to requests</small>
            </div>
          <% } %>
          
          <!-- No Auth for Public endpoints -->
          <% if (!ep.auth) { %>
            <div class="info-message">
              <i class="fas fa-globe"></i> This is a public endpoint - no authentication required
            </div>
          <% } %>
        </div>
        
        <button type="submit" class="btn-send">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>
          </svg>
          Send Request
        </button>
        
        <div class="response-area" style="display:none;">
          <div class="response-header">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M7 20L17 10 7 0"/>
            </svg>
            <span>Response</span>
            <button type="button" class="btn-copy-response" data-action="copy-response">📋 Copy</button>
          </div>
          <pre class="response-data"></pre>
        </div>
      </form>
    </div>
    
    <!-- RIGHT: Code Example -->
    <div class="endpoint-code-section">
      <div class="section-header">
        <svg class="section-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M16 18L22 12 16 6M8 6L2 12 8 18"/>
        </svg>
        <span>Code Example</span>
        <button class="btn-copy-code" data-action="copy-code">📋 Copy</button>
      </div>
      <div class="code-wrapper">
        <pre><code class="language-javascript"><%= ep.jsExample || '// Example not available' %></code></pre>
      </div>
      <div class="code-response-preview">
        <div class="preview-header">Example Response</div>
        <pre><code class="language-json"><%= typeof ep.response === 'object' ? JSON.stringify(ep.response, null, 2) : (ep.response || '{}') %></code></pre>
      </div>
    </div>
  </div>
</div>

<!-- Pagination for list endpoints -->
<% if (ep.method === 'GET' && ep.isList) { %>
  <div class="pagination-container" data-endpoint="<%= ep.path %>">
    <div class="pagination-controls">
      <button class="page-btn" data-action="first">⏮ First</button>
      <button class="page-btn" data-action="prev">◀ Prev</button>
      <span class="page-info">Page <span class="current-page">1</span> of <span class="total-pages">1</span></span>
      <button class="page-btn" data-action="next">Next ▶</button>
      <button class="page-btn" data-action="last">Last ⏭</button>
      <select class="page-size-select">
        <option value="10">10 per page</option>
        <option value="25" selected>25 per page</option>
        <option value="50">50 per page</option>
        <option value="100">100 per page</option>
      </select>
    </div>
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <% ep.tableHeaders?.forEach(function(header) { %>
              <th><%= header %></th>
            <% }) %>
          </tr>
        </thead>
        <tbody class="table-body">
          <tr class="loading-cell"><td colspan="100">Loading data...<\/td><\/tr>
        </tbody>
      </table>
    </div>
  </div>
<% } %>